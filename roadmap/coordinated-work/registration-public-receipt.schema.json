{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-contract:coordinated-work:registration-public-receipt:1",
  "title": "Coordinated Work offline registration consistency receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "programme_id", "graph_sha256", "source_commit", "observed_at",
    "registration_snapshot", "native_live_verification", "execution_status",
    "bound_proposals", "bound_programmes", "bound_epics", "bound_tasks",
    "matched_blocking_dependencies", "advisory_links_not_used_as_blockers",
    "reference_only_parent_bindings", "proposal_ids", "limitation"
  ],
  "properties": {
    "schema": {"const": "kc-cw-registration-public-receipt/1"},
    "programme_id": {"type": "string", "pattern": "^KC-CW-[A-Za-z0-9][A-Za-z0-9-]*$"},
    "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "registration_snapshot": {"const": "OFFLINE_CONSISTENT"},
    "native_live_verification": {"const": "NOT_PERFORMED_BY_THIS_TOOL"},
    "execution_status": {"const": "NOT_INFERRED"},
    "bound_proposals": {"type": "integer", "minimum": 1},
    "bound_programmes": {"const": 1},
    "bound_epics": {"type": "integer", "minimum": 1},
    "bound_tasks": {"type": "integer", "minimum": 1},
    "matched_blocking_dependencies": {"type": "integer", "minimum": 0},
    "advisory_links_not_used_as_blockers": {"type": "integer", "minimum": 0},
    "reference_only_parent_bindings": {"type": "integer", "minimum": 0},
    "proposal_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(KC-CW-[A-Za-z0-9][A-Za-z0-9-]*|CW-[A-Z]+[0-9]{2,})$"}
    },
    "limitation": {"const": "Offline consistency only; no Muneral request or source authentication was performed."}
  }
}
