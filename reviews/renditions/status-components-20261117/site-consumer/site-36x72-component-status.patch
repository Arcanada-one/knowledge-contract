+class StatusElement:
+    """Small structural tree for the site's emitted status components, not a browser DOM."""
+
+    def __init__(self, tag, attrs, parent=None):
+        self.tag, self.attrs, self.parent = tag, attrs, parent
+        self.children = []
+
+    def has_class(self, name):
+        return name in (self.attrs.get("class") or "").split()
+
+    def ancestors(self):
+        node = self
+        while node is not None:
+            yield node
+            node = node.parent
+
+    def nearest(self, predicate):
+        return next((node for node in self.ancestors() if predicate(node)), None)
+
+    def contains(self, other):
+        return any(node is self for node in other.ancestors())
+
+    def text_nodes(self):
+        for child in self.children:
+            if isinstance(child, str):
+                yield self, child
+            else:
+                yield from child.text_nodes()
+
+    def text(self):
+        return "".join(text for _, text in self.text_nodes())
+
+
+def effective_status_language(node):
+    # An absent lang inherits; lang="" explicitly makes the language unknown.
+    for ancestor in node.ancestors():
+        if "lang" in ancestor.attrs:
+            return (ancestor.attrs["lang"] or "").strip().casefold()
+    return ""
+
+
+STATUS_INLINE_VALUES = {
+    "display": {"none", "inline", "block", "inline-block", "contents", "flow-root", "list-item",
+                "flex", "inline-flex", "grid", "inline-grid", "table", "inline-table",
+                "table-row-group", "table-header-group", "table-footer-group", "table-row",
+                "table-column-group", "table-column", "table-cell", "table-caption"},
+    "visibility": {"visible", "hidden", "collapse"},
+    "content-visibility": {"visible", "hidden", "auto"},
+}
+
+
+def inline_status_style(node):
+    """Read only literal inline declarations relevant to this bounded witness check.
+
+    The closed literal grammar is STATUS_INLINE_VALUES. An unrecognised value
+    cannot cancel a supported exclusion; this is deliberately conservative for
+    valid CSS outside that grammar. CSS-wide keywords, escaped tokens, variables,
+    stylesheets and general computed/cascade effects are outside this check.
+    An inline !important declaration wins over a later non-important declaration
+    of the same supported property. Invalid later declarations do not erase a
+    previously understood declaration (CSS Syntax 3, consume a declaration).
+    """
+    import re
+    style = re.sub(r"/\*.*?\*/", "", node.attrs.get("style") or "", flags=re.S)
+    values = {}
+    for declaration in style.split(";"):
+        name, separator, value = declaration.partition(":")
+        name = name.strip().casefold()
+        if not separator or name not in STATUS_INLINE_VALUES:
+            continue
+        important = bool(re.search(r"!\s*important\s*$", value, re.I))
+        value = re.sub(r"!\s*important\s*$", "", value, flags=re.I).strip().casefold()
+        if value not in STATUS_INLINE_VALUES[name]:
+            continue
+        if name not in values or important or not values[name][1]:
+            values[name] = (value, important)
+    return {name: value for name, (value, _) in values.items()}
+
+
+def status_text_exposed(node):
+    """Whether explicit HTML/inline exclusions permit this status witness.
+
+    aria-hidden is an accessibility exclusion, not a claim of visual hiding.
+    Excluded redundant badges may coexist with a usable badge in the required
+    component. This is not an accessible-name or assistive-technology solver.
+    """
+    visibility = None
+    for ancestor in node.ancestors():
+        attrs = ancestor.attrs
+        if ("hidden" in attrs or "inert" in attrs or ancestor.tag == "template"
+                or (attrs.get("aria-hidden") or "").strip().casefold() == "true"):
+            return False
+        style = inline_status_style(ancestor)
+        if style.get("display") == "none" or style.get("content-visibility") == "hidden":
+            return False
+        if visibility is None and style.get("visibility") in {"visible", "hidden", "collapse"}:
+            visibility = style["visibility"]
+    return visibility not in {"hidden", "collapse"}
+
+
+class StatusBadgeBindings(HTMLParser):
+    """Read work bindings together with their actual renderer component and ancestry."""
+    VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"}
+
+    def __init__(self, html: str):
+        super().__init__(convert_charrefs=True)
+        self.root = StatusElement("#document", {})
+        self.stack = [self.root]
+        self.nodes = []
+        self.links = []
+        self.badge_nodes = []
+        self.link_paths = set()
+        self.feed(html)
+        self.close()
+        self.active = [node for node in self.stack if node.has_class("status-badge")]
+        self.badges = [(self.badge_work(node), node.text()) for node in self.badge_nodes]
+
+    @staticmethod
+    def link_path(node):
+        href = node.attrs.get("href") or ""
+        return urlsplit(href).path if href.startswith("/") and not href.startswith("//") else None
+
+    @staticmethod
+    def badge_work(node):
+        parent = node.parent
+        owners = [a for a in node.ancestors() if "data-work-status" in a.attrs]
+        return (parent.attrs.get("data-work-status")
+                if node.tag == "span" and parent is not None and parent.tag == "span"
+                and len(owners) == 1 and owners[0] is parent else None)
+
+    @staticmethod
+    def usable(node, locale):
+        text_nodes = [parent for parent, text in node.text_nodes() if text.strip()]
+        return bool(text_nodes) and all(
+            effective_status_language(part) == locale.casefold() and status_text_exposed(part)
+            for part in [node, *text_nodes]
+        )
+
+    def handle_starttag(self, tag, attributes):
+        attrs = dict(attributes)
+        node = StatusElement(tag, attrs, self.stack[-1])
+        self.stack[-1].children.append(node)
+        self.nodes.append(node)
+        if tag == "a":
+            self.links.append(node)
+            path = self.link_path(node)
+            if path is not None:
+                self.link_paths.add(path)
+        if "status-badge" in (attrs.get("class") or "").split():
+            self.badge_nodes.append(node)
+        if tag not in self.VOID:
+            self.stack.append(node)
+
+    def handle_startendtag(self, tag, attributes):
+        self.handle_starttag(tag, attributes)
+        if tag not in self.VOID:
+            self.handle_endtag(tag)
+
+    def handle_data(self, value):
+        self.stack[-1].children.append(value)
+
+    def handle_endtag(self, tag):
+        index = next((i for i in range(len(self.stack) - 1, 0, -1) if self.stack[i].tag == tag), None)
+        if index is None:
+            return
+        del self.stack[index:]
+
+    def adjacent_badges(self, link):
+        """The emitted link's following badge run, allowing a redundant excluded copy."""
+        siblings = link.parent.children
+        found = []
+        for sibling in siblings[siblings.index(link) + 1:]:
+            if isinstance(sibling, str):
+                if sibling.strip():
+                    break
+                continue
+            if sibling.tag != "span" or "data-work-status" not in sibling.attrs:
+                break
+            found.extend(node for node in self.badge_nodes if node.parent is sibling)
+        return found
+
+    @staticmethod
+    def reader_container(node):
+        return node.nearest(lambda n: n.has_class("publication-record") and not n.has_class("programme-page"))
+
+    @staticmethod
+    def current_locale_navigation(link, locale):
+        # The global language picker repeats the current reader's own route.
+        # Its status obligation is the separately checked reading-page header,
+        # not an extra badge on the language button itself.
+        return (link.has_class("locale-chip") and link.attrs.get("data-locale") == locale
+                and link.attrs.get("aria-current") == "page"
+                and link.parent is not None and link.parent.has_class("locale-flags")
+                and link.nearest(lambda n: n.tag == "header" and n.attrs.get("id") == "header") is not None)
+
+    def link_component(self, link):
+        # A summary's own link always needs its adjacent badge. The original
+        # prose links below deliberately use per-work grouped summaries.
+        if link.nearest(lambda n: n.has_class("rm-linked-status")) is not None:
+            return "direct link", link
+        field = link.nearest(lambda n: n.tag == "dd" and n.nearest(lambda a: a.has_class("roadmap-fields")) is not None)
+        if field is not None:
+            return "roadmap field", field
+        card = link.nearest(lambda n: n.has_class("paper-card"))
+        if card is not None:
+            return "paper card", card
+        if link.has_class("spec-row") or link.has_class("dialog-result"):
+            return "linked record", link
+        row = link.nearest(lambda n: n.tag == "tr" and n.nearest(lambda a: a.has_class("repository-table")) is not None)
+        if row is not None:
+            return "repository row", row
+        reader = self.reader_container(link)
+        if reader is not None:
+            if link.nearest(lambda n: n.has_class("article-aside")) is not None:
+                return "reader sibling", link
+            if link.nearest(lambda n: n.has_class("source-body")) is not None:
+                return "reader references", reader
+        # Programme links (including foundation cards and tables) are emitted
+        # with an adjacent badge for every occurrence; no page-wide fallback.
+        return "direct link", link
+
+    def summary_badges(self, scope, kind, route):
+        found = []
+        for link in self.links:
+            if self.link_path(link) != route:
+                continue
+            summary = link.nearest(lambda n: n.has_class("rm-linked-status"))
+            if summary is None:
+                continue
+            if kind == "roadmap field":
+                same_component = summary.parent is scope
+            else:
+                same_component = (summary.parent is not None and summary.parent.has_class("article-aside")
+                                  and self.reader_container(summary) is scope)
+            if same_component:
+                found.extend(self.adjacent_badges(link))
+        return found
+
+    def component_badges(self, kind, scope, route):
+        if kind == "direct link":
+            return self.adjacent_badges(scope)
+        if kind in {"reader references", "roadmap field"}:
+            return self.summary_badges(scope, kind, route)
+        if scope is None:
+            return []
+        if kind == "paper card":
+            owner = lambda n: n.has_class("paper-card")
+        elif kind == "repository row":
+            owner = lambda n: n.tag == "tr"
+        elif kind == "reading-page header":
+            owner = lambda n: n.has_class("page-head")
+        else:
+            owner = lambda n: n.tag == "a"
+        return [node for node in self.badge_nodes if node.nearest(owner) is scope]
+
