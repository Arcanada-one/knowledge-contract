+
+def check_inventory(documents, *, slug_key="slug"):
+    try:
+        actual = [(d["type"], d[slug_key], d["path"], d["route"]) for d in documents]
+    except (KeyError, TypeError) as error:
+        raise ValueError(f"Publication inventory has an incomplete work identity: {error}") from error
+    if len(actual) != EXPECTED_COUNT or Counter(row[0] for row in actual) != EXPECTED_TYPE_COUNTS:
+        raise ValueError("Expected exactly 36 canonical works with type counts 11/13/8/1/1/2")
+    expected, observed = Counter(EXPECTED_WORKS), Counter(actual)
+    if observed != expected:
+        missing = sorted((expected - observed).elements())
+        unexpected = sorted((observed - expected).elements())
+        raise ValueError(f"Publication work identities differ: missing={missing}; unexpected={unexpected}")
