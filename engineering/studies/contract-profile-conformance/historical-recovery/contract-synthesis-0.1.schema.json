{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meaning-management:kc-synthesis:0.1",
  "title": "I26 bounded Knowledge Contract v3 wire profile",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "const": "3.0.0-draft.1"
        },
        "wire_version": {
          "const": "kc-synthesis/0.1"
        }
      },
      "required": [
        "id",
        "revision",
        "contract_version",
        "wire_version"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "type": "object",
      "properties": {
        "intent": {
          "enum": [
            "inform",
            "plan",
            "execute",
            "learn"
          ]
        },
        "task": {
          "$ref": "#/$defs/task"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requirements_revision": {
          "type": "string",
          "minLength": 1
        },
        "profile_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "intent",
        "task",
        "requirements",
        "requirements_revision",
        "profile_requirements"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "grounds": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "sources",
        "provenance"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "projection": {
      "type": "object",
      "properties": {
        "included_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "omitted_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "losses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loss"
          }
        },
        "modalities": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "image"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "included_ids",
        "omitted_ids",
        "losses",
        "modalities"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "required": [
    "identity",
    "purpose",
    "content",
    "scope",
    "grounds",
    "dependencies",
    "obligations",
    "projection",
    "observations",
    "profiles"
  ],
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "withheld"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "value",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "withheld"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "conditions",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "not": {
                  "const": "known"
                }
              }
            }
          },
          "then": {
            "properties": {
              "conditions": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "claim",
            "hypothesis",
            "procedure",
            "constraint",
            "requirement",
            "criterion",
            "description",
            "observation",
            "norm"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "critical": {
          "type": "boolean"
        },
        "condition_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "critical",
        "condition_ids",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "withheld"
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "locator",
        "state"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "required",
            "navigation"
          ]
        }
      },
      "required": [
        "from_id",
        "to_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "preserve",
            "profile",
            "coverage"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "target"
      ],
      "additionalProperties": false
    },
    "loss": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target",
        "reason"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_revision": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "validation",
            "execution",
            "utility",
            "learning"
          ]
        },
        "outcome": {
          "enum": [
            "unknown",
            "supported",
            "refuted",
            "conflict"
          ]
        }
      },
      "required": [
        "id",
        "subject_id",
        "subject_revision",
        "kind",
        "outcome"
      ],
      "additionalProperties": false
    },
    "professional": {
      "type": "object",
      "properties": {
        "work": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "requirements_revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "revision",
            "requirements_revision"
          ],
          "additionalProperties": false
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "responsibilities"
            ],
            "additionalProperties": false
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "description",
              "required"
            ],
            "additionalProperties": false
          }
        },
        "blueprints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "process",
                  "structural"
                ]
              },
              "skill_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "kind",
              "skill_ids"
            ],
            "additionalProperties": false
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "capability": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown",
                "not_applicable",
                "withheld"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "evidence_ids"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "known"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence_ids": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "authority": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "known",
                "unknown",
                "not_applicable",
                "withheld"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "evidence_ids"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "known"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence_ids": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "function": {
                "enum": [
                  "goal",
                  "executor",
                  "verifier",
                  "release",
                  "risk",
                  "resource",
                  "remediation"
                ]
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "function",
              "actor",
              "scope"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "work",
        "roles",
        "skills",
        "blueprints",
        "criteria",
        "capability",
        "authority",
        "assignments"
      ],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_revision": {
          "type": "string",
          "minLength": 1
        },
        "memory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "promotion": {
          "enum": [
            "none",
            "proposal",
            "accepted"
          ]
        }
      },
      "required": [
        "user_id",
        "task_id",
        "branch_id",
        "goal_revision",
        "memory_ids",
        "promotion"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "protected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "document_id",
        "revision",
        "audience",
        "purpose",
        "unit_ids",
        "protected_ids"
      ],
      "additionalProperties": false
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "premise_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conclusion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "conflict_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "premise_ids",
        "conclusion_ids",
        "method",
        "conflict_ids"
      ],
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "properties": {
        "representations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "modality": {
                "const": "image"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "delivered": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "revision",
              "modality",
              "selector",
              "delivered"
            ],
            "additionalProperties": false
          }
        },
        "required_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "representations",
        "required_ids"
      ],
      "additionalProperties": false
    },
    "reuse": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "dependency_pins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "mode": {
          "enum": [
            "current",
            "as_of"
          ]
        },
        "as_of": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "artifact_id",
        "revision",
        "dependency_pins",
        "mode",
        "as_of"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "version",
        "required",
        "selection_reason",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "professional"
              },
              "version": {
                "const": "0.1"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/professional"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "dialogue"
              },
              "version": {
                "const": "0.1"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/dialogue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "document"
              },
              "version": {
                "const": "0.1"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/document"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "reasoning"
              },
              "version": {
                "const": "0.1"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/reasoning"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "visual"
              },
              "version": {
                "const": "0.1"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/visual"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "reuse"
              },
              "version": {
                "const": "0.1"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/reuse"
              }
            }
          }
        }
      ]
    }
  }
}
