{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.place/schemas/document-classification.schema.json",
  "title": "DocumentClassification/v1",
  "description": "The result of the classify stage of the knowledge-supply pipeline for one document: one class of the kc-doc-class/1 canon, or an explicit statement that the class is ambiguous or unknown. It is bound to the classify receipt by the sha256 of its exact bytes (output role classification). It does not set rights, damage, readiness, publication, indexing or admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "document_id",
    "taxonomy_id",
    "canon_sha256",
    "status",
    "class",
    "candidates",
    "coverage",
    "classifier",
    "evidence",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "DocumentClassification/v1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^d_[0-9a-f]{64}$"
    },
    "taxonomy_id": {
      "type": "string",
      "pattern": "^kc-doc-class/[0-9]+$"
    },
    "canon_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "classified",
        "ambiguous",
        "unknown"
      ]
    },
    "class": {
      "enum": [
        "book",
        "paper",
        "export",
        "dataset",
        "other",
        null
      ]
    },
    "candidates": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5,
      "items": {
        "enum": [
          "book",
          "paper",
          "export",
          "dataset",
          "other"
        ]
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "not_measured"
      ]
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "method"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "representation_sha256",
          "basis"
        ],
        "properties": {
          "representation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "selector",
                  "rule",
                  "feature"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        }
      }
    },
    "confidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "not_measured"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "method",
            "version",
            "score",
            "interpretation"
          ],
          "properties": {
            "status": {
              "const": "measured"
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "interpretation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "classified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "class": {
            "enum": [
              "book",
              "paper",
              "export",
              "dataset",
              "other"
            ]
          },
          "candidates": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "book"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "const": [
              "book"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "paper"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "const": [
              "paper"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "export"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "const": [
              "export"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "dataset"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "const": [
              "dataset"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "other"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "const": [
              "other"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ambiguous"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "class": {
            "type": "null"
          },
          "candidates": {
            "minItems": 2,
            "items": {
              "enum": [
                "book",
                "paper",
                "export",
                "dataset"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "class": {
            "type": "null"
          },
          "candidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "partial"
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "required": [
          "coverage_note"
        ]
      }
    }
  ]
}
