{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.place/schemas/location-registry.schema.json",
  "title": "Knowledge Contract location registry, version 1",
  "description": "Registry of physical copies keyed by source/package id. Repository-only: the location-registry contract is not part of the published corpus.",
  "oneOf": [
    {"$ref": "#/$defs/LocationRegistry"},
    {"$ref": "#/$defs/LocationVerifyReceipt"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceId": {"type": "string", "pattern": "^d_[0-9a-f]{64}$"},
    "packageId": {
      "type": "string",
      "pattern": "^d_[0-9a-f]{64}/[A-Za-z0-9][A-Za-z0-9._@+-]{0,119}$"
    },
    "objectId": {
      "oneOf": [
        {"$ref": "#/$defs/sourceId"},
        {"$ref": "#/$defs/packageId"}
      ]
    },
    "LocationRegistryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "object_kind",
        "object_id",
        "holder_host",
        "volume",
        "path",
        "role",
        "size_bytes",
        "verified_at",
        "verified_sha256"
      ],
      "properties": {
        "schema": {"const": "LocationRegistryRow/v1"},
        "object_kind": {"enum": ["original", "package"]},
        "object_id": {"$ref": "#/$defs/objectId"},
        "holder_host": {"type": "string", "minLength": 1, "maxLength": 253},
        "volume": {"type": "string", "minLength": 1, "maxLength": 512},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "role": {"enum": ["primary", "mirror", "backup"]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "verified_at": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "verified_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"object_kind": {"const": "original"}}},
          "then": {"properties": {"object_id": {"$ref": "#/$defs/sourceId"}}}
        },
        {
          "if": {"properties": {"object_kind": {"const": "package"}}},
          "then": {"properties": {"object_id": {"$ref": "#/$defs/packageId"}}}
        }
      ]
    },
    "LocationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contour", "entries"],
      "properties": {
        "schema": {"const": "LocationRegistry/v1"},
        "contour": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Named holder contour, e.g. arcana-dbs:/srv/source-library"
        },
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/LocationRegistryRow"}
        },
        "notes": {"type": "string", "maxLength": 2000}
      }
    },
    "LocationVerifyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "tool",
        "started_at",
        "finished_at",
        "registry_sha256",
        "counts",
        "non_ok",
        "kc2_admission"
      ],
      "properties": {
        "schema": {"const": "LocationVerifyReceipt/v1"},
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,95}$"},
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 120},
            "version": {"type": "string", "minLength": 1, "maxLength": 120}
          }
        },
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "missing", "corrupt", "not_measured"],
          "properties": {
            "ok": {"type": "integer", "minimum": 0},
            "missing": {"type": "integer", "minimum": 0},
            "corrupt": {"type": "integer", "minimum": 0},
            "not_measured": {"type": "integer", "minimum": 0}
          }
        },
        "non_ok": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_id", "role", "classification"],
            "properties": {
              "object_id": {"$ref": "#/$defs/objectId"},
              "role": {"enum": ["primary", "mirror", "backup"]},
              "classification": {
                "enum": ["missing", "corrupt", "not_measured"]
              },
              "reason": {"type": "string", "maxLength": 1000},
              "observed_sha256": {
                "oneOf": [
                  {"type": "null"},
                  {"$ref": "#/$defs/sha256"}
                ]
              }
            }
          }
        },
        "truncated": {"type": "boolean"},
        "kc2_admission": {"const": "not_measured"}
      }
    }
  }
}
