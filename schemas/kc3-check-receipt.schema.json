{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.place/schemas/kc3-check-receipt.schema.json",
  "title": "Result of one pre-registered check (KC3CheckReceipt/v1) and the revision proposal it may produce (KC3RevisionProposal/v1)",
  "oneOf": [
    {
      "$ref": "#/$defs/Receipt"
    },
    {
      "$ref": "#/$defs/Proposal"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "relpath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]{1,200}$"
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receipt_id",
        "check_id",
        "prereg",
        "data_digests",
        "run",
        "controls",
        "gates_met",
        "n",
        "result",
        "outcome",
        "limits",
        "reviewer_independence_class",
        "spend",
        "qualifications"
      ],
      "properties": {
        "schema": {
          "const": "KC3CheckReceipt/v1"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{3,80}$"
        },
        "check_id": {
          "type": "string",
          "pattern": "^KC3-P(0[0-9]|1[0-3])-C[1-9]$"
        },
        "prereg": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "commit"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "commit": {
              "type": "string",
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
            }
          }
        },
        "data_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at",
            "finished_at",
            "harness_commit",
            "seed"
          ],
          "properties": {
            "started_at": {
              "$ref": "#/$defs/timestamp"
            },
            "finished_at": {
              "$ref": "#/$defs/timestamp"
            },
            "harness_commit": {
              "$ref": "#/$defs/commit"
            },
            "seed": {
              "type": "integer"
            }
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positive_passed",
            "negative_failed"
          ],
          "properties": {
            "positive_passed": {
              "type": "boolean"
            },
            "negative_failed": {
              "type": "boolean"
            }
          }
        },
        "gates_met": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "object",
          "minProperties": 1
        },
        "outcome": {
          "enum": [
            "supported",
            "refuted",
            "not_measured"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "reviewer_independence_class": {
          "enum": [
            "not_applicable",
            "same_account_blind_agent",
            "different_account",
            "human"
          ]
        },
        "spend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paid_calls"
          ],
          "properties": {
            "paid_calls": {
              "type": "boolean"
            },
            "cap_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "used_usd": {
              "type": "number",
              "minimum": 0
            },
            "cap_recorded_at": {
              "$ref": "#/$defs/timestamp"
            },
            "provider": {
              "type": "string",
              "minLength": 2
            },
            "model": {
              "type": "string",
              "minLength": 2
            },
            "tokens_in": {
              "type": "integer",
              "minimum": 0
            },
            "tokens_out": {
              "type": "integer",
              "minimum": 0
            },
            "decision_id": {
              "const": "DEC-AUP-0174"
            }
          }
        },
        "revision_proposal_ref": {
          "$ref": "#/$defs/relpath"
        },
        "claim_weakened": {
          "type": "boolean"
        },
        "weakening_reason": {
          "type": "string",
          "minLength": 10
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not_measured"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "refuted"
              }
            }
          },
          "then": {
            "required": [
              "revision_proposal_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "spend": {
                "properties": {
                  "paid_calls": {
                    "const": true
                  }
                },
                "required": [
                  "paid_calls"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "spend": {
                "required": [
                  "cap_usd",
                  "used_usd",
                  "cap_recorded_at",
                  "provider",
                  "model",
                  "tokens_in",
                  "tokens_out",
                  "decision_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "claim_weakened"
            ],
            "properties": {
              "claim_weakened": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "weakening_reason",
              "revision_proposal_ref"
            ]
          }
        }
      ]
    },
    "Proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "proposal_id",
        "paper",
        "check_id",
        "receipt_ref",
        "finding",
        "claim_affected",
        "proposed_change",
        "paper_sha256_at_proposal",
        "status",
        "route"
      ],
      "properties": {
        "schema": {
          "const": "KC3RevisionProposal/v1"
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{3,80}$"
        },
        "paper": {
          "type": "string",
          "pattern": "^P(0[0-9]|1[0-3])$"
        },
        "check_id": {
          "type": "string",
          "pattern": "^KC3-P(0[0-9]|1[0-3])-C[1-9]$"
        },
        "receipt_ref": {
          "$ref": "#/$defs/relpath"
        },
        "finding": {
          "enum": [
            "refuted",
            "weakened"
          ]
        },
        "claim_affected": {
          "type": "string",
          "minLength": 20
        },
        "proposed_change": {
          "type": "string",
          "minLength": 20
        },
        "paper_sha256_at_proposal": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "proposed"
        },
        "route": {
          "const": "P10 revision and canon"
        }
      }
    }
  }
}
