{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.place/schemas/pipeline-receipt.schema.json",
  "title": "Knowledge Contract pipeline stage receipt, version 1",
  "description": "One receipt per pipeline stage of one document. Repository-only: the pipeline contract (engineering/specifications/pipeline) is not part of the published corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document_id", "stage", "run_id", "previous_receipt_sha256", "tool", "started_at", "finished_at", "outcome", "rights_class", "inputs", "outputs", "kc2_admission"],
  "properties": {
    "schema": {"const": "PipelineStageReceipt/v1"},
    "document_id": {"type": "string", "pattern": "^d_[0-9a-f]{64}$"},
    "stage": {"enum": ["intake", "classify", "convert", "recognise", "bundle", "kc-package", "library", "publish", "index"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,95}$"},
    "previous_receipt_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["done", "skipped", "paused_safe", "refused", "failed"]},
    "reason": {"type": "string", "pattern": "\\S", "maxLength": 1000},
    "rights_class": {"enum": ["author_open", "public_domain", "third_party_restricted", "unknown"]},
    "inputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artefact"}},
    "outputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artefact"}},
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "status": {"enum": ["measured", "not_measured"]},
          "value": {"type": ["number", "string", "boolean"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "measured"}}}, "then": {"required": ["value"], "not": {"required": ["reason"]}}},
          {"if": {"properties": {"status": {"const": "not_measured"}}}, "then": {"required": ["reason"], "not": {"required": ["value"]}}}
        ]
      }
    },
    "kc2_admission": {"const": "not_measured"}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "done"}}}, "then": {"properties": {"inputs": {"minItems": 1}, "outputs": {"minItems": 1}}, "not": {"required": ["reason"]}}},
    {"if": {"properties": {"outcome": {"enum": ["paused_safe", "refused", "failed"]}}}, "then": {"required": ["reason"], "properties": {"outputs": {"maxItems": 0}}}},
    {"if": {"properties": {"outcome": {"const": "skipped"}}}, "then": {"required": ["reason"], "properties": {"inputs": {"maxItems": 0}, "outputs": {"maxItems": 0}}}}
  ],
  "$defs": {
    "artefact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sha256"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
