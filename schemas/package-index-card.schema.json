{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.place/schemas/package-index-card.schema.json",
  "title": "Knowledge Contract package index card and ingest receipt, version 1",
  "description": "Repository-only: index cards for book packages carry source/package ids, span and licence/publication state; paths live only in the location registry. Not part of the published corpus.",
  "oneOf": [
    {"$ref": "#/$defs/PackageIndexCard"},
    {"$ref": "#/$defs/PackageIngestReceipt"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceId": {"type": "string", "pattern": "^d_[0-9a-f]{64}$"},
    "packageId": {
      "type": "string",
      "pattern": "^d_[0-9a-f]{64}/[A-Za-z0-9][A-Za-z0-9._@+-]{0,119}$"
    },
    "packageSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
    },
    "exporterPathSlug": {
      "type": "string",
      "pattern": "^pkg-[a-f0-9]{12}-[a-f0-9]{8}$"
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["full_document", "section_block", "page_bbox", "spine_offset"]
        },
        "section_id": {"type": "string", "maxLength": 256},
        "block_id": {"type": "string", "maxLength": 256},
        "page_id": {"type": "string", "maxLength": 64},
        "note": {"type": "string", "maxLength": 1000}
      }
    },
    "PackageIndexCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "package_id",
        "package_slug",
        "exporter_path_slug",
        "span",
        "licence",
        "publication_state",
        "layer",
        "source_path",
        "content_sha256",
        "damage_places",
        "kc2_admission"
      ],
      "properties": {
        "schema": {"const": "PackageIndexCard/v1"},
        "source_id": {"$ref": "#/$defs/sourceId"},
        "package_id": {"$ref": "#/$defs/packageId"},
        "package_slug": {"$ref": "#/$defs/packageSlug"},
        "exporter_path_slug": {"$ref": "#/$defs/exporterPathSlug"},
        "span": {"$ref": "#/$defs/Span"},
        "licence": {"type": "string", "minLength": 1, "maxLength": 120},
        "publication_state": {
          "enum": [
            "public_domain",
            "author_open",
            "third_party_restricted",
            "unknown"
          ]
        },
        "layer": {"enum": ["document", "readable", "knowledge"]},
        "source_path": {
          "type": "string",
          "pattern": "^articles/book-packages/pkg-[a-f0-9]{12}-[a-f0-9]{8}/(document|readable|knowledge)\\.md$"
        },
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "damage_places": {"type": "integer", "minimum": 0},
        "damage_status": {"type": "string", "maxLength": 64},
        "knowledge_ready": {"type": "boolean"},
        "kc2_admission": {"const": "not_measured"}
      }
    },
    "PackageIngestReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "tool",
        "started_at",
        "finished_at",
        "dry_run",
        "counts",
        "cards",
        "edges",
        "kc2_admission"
      ],
      "properties": {
        "schema": {"const": "PackageIngestReceipt/v1"},
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,95}$"
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 120},
            "version": {"type": "string", "minLength": 1, "maxLength": 120}
          }
        },
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "dry_run": {"type": "boolean"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packages_seen",
            "cards_staged",
            "skipped_unchanged",
            "refused",
            "tombstoned",
            "edges_planned",
            "not_measured"
          ],
          "properties": {
            "packages_seen": {"type": "integer", "minimum": 0},
            "cards_staged": {"type": "integer", "minimum": 0},
            "skipped_unchanged": {"type": "integer", "minimum": 0},
            "refused": {"type": "integer", "minimum": 0},
            "tombstoned": {"type": "integer", "minimum": 0},
            "edges_planned": {"type": "integer", "minimum": 0},
            "not_measured": {"type": "integer", "minimum": 0}
          }
        },
        "cards": {
          "type": "array",
          "items": {"$ref": "#/$defs/PackageIndexCard"}
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_path",
              "target_path",
              "edge_type",
              "created_by"
            ],
            "properties": {
              "source_path": {"type": "string", "minLength": 1, "maxLength": 1024},
              "target_path": {"type": "string", "minLength": 1, "maxLength": 1024},
              "edge_type": {"type": "string", "minLength": 1, "maxLength": 64},
              "weight": {"type": "number"},
              "created_by": {"type": "string", "minLength": 1, "maxLength": 120},
              "relation_id": {"type": "string", "maxLength": 256}
            }
          }
        },
        "refusals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package_slug", "code"],
            "properties": {
              "package_slug": {"type": "string"},
              "code": {"type": "string"},
              "detail": {"type": "string", "maxLength": 1000}
            }
          }
        },
        "live_search": {
          "enum": ["not_measured", "measured"],
          "description": "Live Scrutator search against production feeder remains not_measured until measured."
        },
        "live_s3_resolve": {
          "enum": ["not_measured", "measured"],
          "description": "Card source_id resolve through S3 retrieval remains not_measured until S3 freeze."
        },
        "live_edges_query": {
          "enum": ["not_measured", "measured"]
        },
        "kc2_admission": {"const": "not_measured"}
      }
    }
  }
}
